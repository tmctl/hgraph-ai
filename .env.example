# Hgraph MCP Server Configuration

# Network Configuration (mainnet or testnet)
HGRAPH_NETWORK=mainnet

# API Endpoints (optional - defaults to mainnet)
HGRAPH_GRAPHQL_ENDPOINT=https://mainnet.hedera.api.hgraph.com/v1/graphql
HGRAPH_REST_ENDPOINT=https://mainnet.mirrornode.hedera.com/api/v1
HGRAPH_JSONRPC_ENDPOINT=https://mainnet.hedera.api.hgraph.com/v1/jsonrpc

# Hgraph API Key (optional but recommended for higher rate limits)
HGRAPH_API_KEY=

# Database Configuration (for natural language queries)
DB_HOST=
DB_PORT=5432
DB_DATABASE=hgraph
DB_USERNAME=
DB_PASSWORD=
DB_SSL=true

# OpenAI Configuration (for AI-powered features)
OPENAI_API_KEY=

# Anthropic Configuration (for database natural language queries)
ANTHROPIC_API_KEY=

# MCP HTTP Server Configuration
MCP_PORT=3001

# Authentication Tokens (comma-separated list)
# Generate secure tokens: openssl rand -hex 32
MCP_API_TOKENS=

# OAuth 2.0 Configuration
OAUTH_ENABLED=false

# Google OAuth (optional)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Auth0 OAuth (optional)
OAUTH_AUTH0_DOMAIN=https://your-tenant.auth0.com
OAUTH_AUTH0_CLIENT_ID=
OAUTH_AUTH0_CLIENT_SECRET=
OAUTH_AUTH0_AUDIENCE=
OAUTH_AUTH0_JWKS_URI=https://your-tenant.auth0.com/.well-known/jwks.json

# Custom OAuth Provider (optional)
OAUTH_CUSTOM_ISSUER=
OAUTH_CUSTOM_AUDIENCE=
OAUTH_CUSTOM_CLIENT_ID=
OAUTH_CUSTOM_CLIENT_SECRET=
OAUTH_CUSTOM_AUTH_URL=
OAUTH_CUSTOM_TOKEN_URL=
OAUTH_CUSTOM_INTROSPECTION_ENDPOINT=

# OAuth Settings
OAUTH_REQUIRED_SCOPES=mcp:read,mcp:tools
OAUTH_CACHE_TIMEOUT=300
OAUTH_DEFAULT_REDIRECT_URI=http://localhost:3000/auth/callback
OAUTH_AUTH_URL=/auth

# CORS Configuration (comma-separated origins or * for all)
MCP_ALLOWED_ORIGINS=http://localhost:3000

# Security Configuration
# Maximum requests per minute per token
RATE_LIMIT_MAX=100
# Rate limit window in milliseconds
RATE_LIMIT_WINDOW=60000

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# Cache Configuration
CACHE_TTL=3600000  # 1 hour in milliseconds
SCHEMA_CACHE_ENABLED=true

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_NETWORK=mainnet