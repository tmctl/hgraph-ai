{
  "name": "hgraph-mcp-server",
  "version": "1.0.0",
  "description": "Hgraph MCP Server - Hedera blockchain data access for Claude",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hgraph-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    ".env.example",
    "claude_mcp_config.json"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "dev:http": "tsx src/http-server.ts",
    "test:http-client": "tsx src/test-http-client.ts",
    "build": "tsc",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest tests/integration",
    "test:unit": "jest tests/unit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.59.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.6.0",
    "body-parser": "^2.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "graphql": "^16.8.0",
    "graphql-request": "^6.1.0",
    "nodemailer": "^7.0.6",
    "nodemailer-mailgun-transport": "^2.1.5",
    "pg": "^8.11.0",
    "sql-formatter": "^15.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.10.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "hedera",
    "blockchain",
    "hgraph",
    "ai",
    "claude",
    "model-context-protocol"
  ],
  "author": "Hgraph Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hgraph-io/hgraph-ai.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/hgraph-io/hgraph-ai#readme",
  "bugs": {
    "url": "https://github.com/hgraph-io/hgraph-ai/issues"
  }
}