# MCP Server Configuration
MCP_HOST=localhost
MCP_PORT=3002
MCP_API_PREFIX=/mcp

# Authorization Settings
# Enable Bearer token authorization (set to 'true' to enable)
MCP_AUTH_ENABLED=false
# Bearer token for authorization (required if MCP_AUTH_ENABLED=true)
# Generate a secure token for production: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Database Configuration (optional, for production)
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
