# MCP Server Configuration
MCP_PORT=3000
MCP_API_TOKENS=your-api-token-here

# Email Configuration (for magic link authentication)
# For Gmail: use smtp.gmail.com, port 587, and an app-specific password
# For Outlook: use smtp-mail.outlook.com, port 587
# For local testing: use localhost, port 1025 (with MailHog)
EMAIL_FROM=noreply@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# For testing with MailHog (local SMTP):
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# OAuth Configuration (optional)
OAUTH_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_AUTH0_DOMAIN=
OAUTH_AUTH0_CLIENT_ID=
OAUTH_AUTH0_CLIENT_SECRET=

# Database Configuration (optional, for production)
DATABASE_URL=postgresql://user:password@localhost:5432/hgraph_mcp

# Environment
NODE_ENV=development
