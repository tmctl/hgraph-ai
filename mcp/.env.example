# Hgraph MCP Server Configuration

# Server Configuration
MCP_PORT=3000

# GraphQL API Configuration
HGRAPH_GRAPHQL_URL=https://mainnet.hedera.api.hgraph.io/v1/graphql
HGRAPH_API_KEY=your-hgraph-api-key-here

# PostgreSQL Database Configuration (Required for ask_question tool)
DB_HOST=your-hgraph-database-host
DB_PORT=5432
DB_DATABASE=hgraph
DB_USERNAME=your-username
DB_PASSWORD=your-password
DB_SSL=true

# Anthropic Configuration (Optional - for natural language to SQL)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# REST API Configuration
HGRAPH_REST_URL=https://mainnet.hedera.api.hgraph.io/v1/pk_prod_ab2c41b848c0b568e96a31ef0ca2f2fbaa549470/api/v1

# Optional: Request timeout in milliseconds
REQUEST_TIMEOUT=30000

# Alternative endpoints for testnet
# HGRAPH_GRAPHQL_URL=https://testnet.hedera.api.hgraph.io/v1/graphql
# HGRAPH_REST_URL=https://testnet.hedera.api.hgraph.io/v1/pk_prod_ab2c41b848c0b568e96a31ef0ca2f2fbaa549470/api/v1
